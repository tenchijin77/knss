---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import campfire from "../assets/alden/menu_campfire.jpg";
import holCapsule from "../assets/hol/header_capsule_920x430.png";
import shot from "../assets/hol/02_mhorzath_total_eclipse.png";
import aldenImg from "../assets/alden/storm_giants_isle_of_lost_souls.jpg";
import racesImg from "../assets/alden/troll_charges_fire_giant_burning_scar.jpg";
import classesImg from "../assets/alden/spectre_twilight_moors_wide.jpg";
import worldImg from "../assets/alden/09_stormbreak_highlands_1.jpg";
import zonesImg from "../assets/alden/01_kordava_1.jpg";
import cover from "../assets/brand/zen-divers-book-cover.jpg";
import { site } from "../data/site";

const world = [
  { href: "/world/#races", label: "Races", src: racesImg, alt: "A troll charges a fire giant in the Burning Scar", pos: "45% center" },
  { href: "/world/#classes", label: "Classes", src: classesImg, alt: "A warrior and a caster against a spectre on the Twilight Moors", pos: "40% center" },
  { href: "/world/#aldenexia", label: "Aldenexia", src: worldImg, alt: "A crystal spirit by the blue spire of the Stormbreak Highlands", pos: "center" },
  { href: "/world/#zones", label: "Zones", src: zonesImg, alt: "A giant beetle on the beach at Kordava", pos: "center" },
];
---
<Base description={site.description}>
  <section class="hero">
    <Image src={campfire} alt="" class="hero-bg" widths={[1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero-fade"></div>
    <div class="wrap hero-inner">
      <h1 class="fire-title"><span>Kuro Neko Sama</span><span class="sub">Studios</span></h1>
      <p class="tagline">Indie games and books.</p>
      <a class="scroll" href={site.links.itchHol} rel="noopener">Heroes of Lumora: Free Demo Out Now</a>
    </div>
  </section>

  <div class="band"><h2>What We're Working On</h2></div>
  <section>
    <div class="wrap grid-2 split">
      <Image src={shot} alt="Mh'orzath's Total Eclipse boss phase in Heroes of Lumora" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 560px" class="shot framed" />
      <div>
        <ul class="now">
          <li><strong><a href="/games/heroes-of-lumora/">Heroes of Lumora</a></strong>: the free demo is out on itch.io, and we're getting the Steam page ready and polishing for launch.</li>
          <li><strong><a href="/games/aldenexia-lightfall/">Aldenexia: Lightfall</a></strong>: in closed testing. We're bringing in new models for the characters and creatures and building out more of the world.</li>
          <li><strong><a href="/books/">Books</a></strong>: <em>Zen Divers</em> and <em>The Lost Art of Being an Asshole</em> are both out on Amazon.</li>
        </ul>
        <div class="btns">{site.links.discord && <a class="btn primary" href={site.links.discord} rel="noopener">Follow along on Discord</a>}<a class="btn ghost" href="/about/">About us</a></div>
      </div>
    </div>
  </section>

  <div class="band"><h2>Games &amp; Books</h2></div>
  <section>
    <div class="wrap grid-3">
      <a class="card panel" href="/games/heroes-of-lumora/">
        <Image src={holCapsule} alt="Heroes of Lumora key art" width={600} class="px" />
        <div class="card-body">
          <div class="tags"><span class="tag cy">Game</span><span class="tag">Free demo on itch.io</span></div>
          <h3>Heroes of Lumora</h3>
          <p class="muted">A fantasy bullet-hell. Five heroes, six endless zones and a 30-minute siege of the town.</p>
        </div>
      </a>
      <a class="card panel" href="/games/aldenexia-lightfall/">
        <Image src={aldenImg} alt="Aldenexia: Lightfall, a party under the storm giants on the Isle of Lost Souls" width={600} class="alden-img" />
        <div class="card-body">
          <div class="tags"><span class="tag mg">Game</span><span class="tag">In development</span></div>
          <h3>Aldenexia: Lightfall</h3>
          <p class="muted">A multiplayer fantasy RPG on a persistent world, built for getting lost in.</p>
        </div>
      </a>
      <a class="card panel" href="/books/">
        <div class="card-art book"><Image src={cover} alt="Zen Divers book cover" width={260} /></div>
        <div class="card-body">
          <div class="tags"><span class="tag cy">Books</span><span class="tag">Available now</span></div>
          <h3>Zen Divers &amp; more</h3>
          <p class="muted">A field guide to advanced scuba skills, and a book on truth and Stoicism.</p>
        </div>
      </a>
    </div>
  </section>

  <div class="band"><h2>The World of Aldenexia</h2><p>One world, two games. Heroes of Lumora defends one of its towns; Aldenexia: Lightfall lets you wander the rest.</p></div>
  <section class="world">
    <div class="wrap sketches">
      {world.map((w) => (
        <a class="sketch" href={w.href}>
          <span class="frame"><Image src={w.src} alt={w.alt} width={520} style={`object-position:${w.pos}`} /></span>
          <span class="cap">{w.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tight stay">
    <div class="wrap">
      <div class="divider"></div>
      <h2>Stay Updated</h2>
      <p class="muted">Play the free demo, join the Discord for devlogs and playtests, or grab logos and screenshots from the press kit.</p>
      <div class="btns center">
        <a class="btn primary" href={site.links.itchHol} rel="noopener">Play the demo</a>
        {site.links.discord && <a class="btn alt" href={site.links.discord} rel="noopener">Join the Discord</a>}
        <a class="btn ghost" href="/press/">Press kit</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: 0; min-height: min(88vh, 820px); display: flex; align-items: flex-start; overflow: hidden; background: var(--night); }
  .hero :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 70%; }
  .hero-fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,14,30,.55) 0%, rgba(12,14,30,.05) 45%, rgba(12,14,30,.15) 80%, rgba(12,14,30,.7) 100%); }
  .hero-inner { position: relative; padding-top: clamp(48px, 9vh, 110px); padding-bottom: 60px; width: 100%; text-align: center; }
  .hero h1 { font-size: clamp(2.8rem, 8.6vw, 7rem); margin: 0 0 .35em; }
  .hero h1 span { display: block; }
  .hero h1 .sub { font-size: .55em; letter-spacing: .32em; margin-top: .12em; }
  .tagline { margin: -6px auto 26px; color: #e4e6f2; font-size: 1.15rem; text-shadow: 0 2px 8px rgba(0,0,0,.8); }

  .split { align-items: center; }
  .framed, .split :global(.shot) { border: 1px solid var(--frame); padding: 6px; background: var(--panel); box-shadow: 0 8px 22px rgba(60, 40, 20, .25); image-rendering: pixelated; }
  .now { list-style: none; padding: 0; margin: 0 0 .5em; display: grid; gap: 16px; }
  .now li { padding-left: 18px; border-left: 3px solid var(--teal); color: var(--muted); font-size: 1.1rem; }
  .now strong a { color: var(--ink); text-decoration: none; font-size: 1.15em; }
  .now strong a:hover { color: var(--cy); }

  .card { display: flex; flex-direction: column; overflow: hidden; text-decoration: none; color: var(--ink); transition: transform .2s ease, box-shadow .2s ease; }
  .card:hover { transform: translateY(-3px); color: var(--ink); box-shadow: 0 10px 26px rgba(60, 40, 20, .25); }
  .card :global(img) { width: 100%; aspect-ratio: 920/430; object-fit: cover; border-bottom: 1px solid var(--line); }
  .card :global(.px) { image-rendering: pixelated; }
  .card :global(.alden-img) { object-position: center 60%; }
  .card-body { padding: 18px 22px 22px; }
  .card-art { aspect-ratio: 920/430; display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .card-art.book { background: linear-gradient(160deg, #0c2a3a, #081723); }
  .card-art.book :global(img) { width: 28%; height: auto; aspect-ratio: auto; border: 0; box-shadow: 0 8px 24px rgba(0,0,0,.6); }

  .world { padding-top: 64px; }
  .sketches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .sketch { text-decoration: none; color: var(--ink); text-align: center; }
  .frame { display: block; border: 1px solid var(--frame); padding: 0; overflow: hidden; aspect-ratio: 1; background: #6d6992; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(1.1); mix-blend-mode: luminosity; transition: filter .35s ease, transform .35s ease; }
  .sketch:hover .frame :global(img) { filter: none; mix-blend-mode: normal; transform: scale(1.04); }
  .cap { display: block; font-family: var(--serif); font-size: 1.5rem; margin-top: 8px; }
  .sketch:hover .cap { color: var(--cy); }
  @media (max-width: 900px) { .sketches { grid-template-columns: repeat(2, 1fr); } }

  .stay { text-align: center; }
  .stay p { margin-left: auto; margin-right: auto; }
  .btns.center { justify-content: center; }
</style>
