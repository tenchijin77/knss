---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base title="Privacy" description="Privacy policy for the Kuro Neko Sama Studios website.">
  <div class="wrap page-hero"><span class="eyebrow">Privacy</span><h1>Privacy</h1></div>
  <section class="tight">
    <div class="wrap prose">
      <p>This website has no accounts, no ads, no tracking cookies and no analytics scripts. It's a set of static pages.</p>
      <p>The site is hosted on Cloudflare, which processes basic request information (such as IP addresses) to deliver pages and protect against abuse. See Cloudflare's own privacy policy for details.</p>
      <p>If you email the studio, your message and address are used only to reply to you and are never sold or shared.</p>
      <p>Store pages for the games (such as Steam) have their own privacy policies.</p>
      <p>Questions: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>
